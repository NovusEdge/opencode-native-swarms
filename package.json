{
  "name": "opencode-native-swarms",
  "version": "0.2.0",
  "description": "Permission-scoped native background-agent workflows for OpenCode",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src/config.ts",
    "src/definitions.ts",
    "src/git.ts",
    "src/index.ts",
    "src/process.ts",
    "src/read.ts",
    "src/search.ts",
    "src/workflow/types.ts",
    "src/workflow/schema.ts",
    "src/workflow/policy.ts",
    "src/workflow/commands.ts",
    "src/workflow/workspace.ts",
    "src/workflow/planner.ts",
    "src/workflow/state.ts",
    "src/workflow/runtime.ts",
    "src/workflow/tools.ts",
    "src/workflow/commands-ui.ts",
    "src/workflow/index.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.18.25"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit",
    "hooks:install": "uvx --from pre-commit==4.6.2 pre-commit install --install-hooks",
    "hooks:run": "uvx --from pre-commit==4.6.2 pre-commit run --all-files",
    "package:check": "bun scripts/check-package.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.25",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.25 <2"
  },
  "dependencies": {
    "picomatch": "4.0.2",
    "zod": "4.1.8"
  }
}
